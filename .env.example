# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Mistral AI API Key (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Admin user IDs (comma-separated Telegram user IDs)
ADMIN_USER_IDS=123456789

# Whitelist mode (true = only approved users can use the bot)
ENABLE_WHITELIST=false

# Pre-approved user IDs (comma-separated, used when ENABLE_WHITELIST=true)
WHITELIST_USER_IDS=123456789

# Banned user IDs (comma-separated)
BLACKLIST_USER_IDS=

# Path to the SQLite database file.
# Local default is fine. On Railway set DB_PATH=/data/mahiro.db and mount a
# Volume at /data so the database survives redeploys.
DB_PATH=data/mahiro.db

# Optional uptime monitoring. Create a "heartbeat"/"cron" monitor on
# UptimeRobot or Better Stack and paste its ping URL here. The bot pings it
# every 5 minutes; if the pings stop, the monitor alerts you. Leave empty to disable.
HEARTBEAT_URL=
