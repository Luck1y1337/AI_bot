# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Mistral AI API Key (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Admin user IDs (comma-separated Telegram user IDs)
ADMIN_USER_IDS=123456789

# JWT secret for web dashboard authentication
ADMIN_PANEL_TOKEN=change_this_to_a_secure_random_string

# Whitelist mode (true = only approved users can use the bot)
ENABLE_WHITELIST=false

# Pre-approved user IDs (comma-separated, used when ENABLE_WHITELIST=true)
WHITELIST_USER_IDS=123456789

# Banned user IDs (comma-separated)
BLACKLIST_USER_IDS=
